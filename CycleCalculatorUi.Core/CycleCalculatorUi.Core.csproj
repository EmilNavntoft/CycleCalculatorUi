<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!-- The EN 12900 compressor collection that ships with the program (CompressorLibrary.ShippedDirectory). -->
    <ItemGroup>
        <None Include="Compressors\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CycleCalculator\CycleCalculator\CycleCalculator.csproj"/>
    </ItemGroup>

</Project>
