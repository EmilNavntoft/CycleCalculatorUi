@* Properties of the selection, generated from the component descriptors. *@
<aside class="panel inspector">
    @if (State.SelectedNode is { } node && State.Catalog.Find(node.TypeId) is { } descriptor)
    {
        IReadOnlyList<ValidationIssue> issues = State.IssuesFor(node.Id);
        <div class="inspector-title">
            <ComponentGlyph TypeId="@node.TypeId" Standalone="true"/>
            <div>
                <div class="eyebrow">@descriptor.DisplayName</div>
                <input class="name-input" value="@node.Name" aria-label="Component name"
                       @onchange="e => State.Rename(node.Id, e.Value?.ToString() ?? node.Name)"/>
            </div>
        </div>
        <p class="description">@descriptor.Description</p>

        <div class="button-row">
            <button type="button" class="ghost" title="Rotate (R)" @onclick="() => State.RotateSelection(90)">Rotate</button>
            <button type="button" class="ghost" title="Flip (F)" @onclick="State.FlipSelection">Flip</button>
            <button type="button" class="ghost danger" title="Delete (Del)" @onclick="State.RemoveSelection">Delete</button>
        </div>

        @if (issues.Any(i => i.ParameterKey is null))
        {
            <ul class="issue-list">
                @foreach (ValidationIssue issue in issues.Where(i => i.ParameterKey is null))
                {
                    <li class="@issue.Severity.ToString().ToLowerInvariant()">@issue.Message</li>
                }
            </ul>
        }

        @if (descriptor.Parameters.Count > 0)
        {
            <section class="inspector-section">
                <h3>Parameters</h3>
                @{ HashSet<string> shownGroups = []; }
                @foreach (ParameterDescriptor parameter in descriptor.Parameters.Where(p => p.Active(node)))
                {
                    if (parameter.Group is not { } groupKey || descriptor.FindGroup(groupKey) is not { } group)
                    {
                        RenderFragment field = @<ParameterField State="State" Node="node" Instance="new ParameterInstance(parameter, parameter.Key, null, 0)"
                                                                Error="@ErrorFor(issues, parameter.Key, node)"/>;
                        if (parameter.Nested)
                        {
                            <div class="nested-param">@field</div>
                        }
                        else
                        {
                            @field
                        }
                        continue;
                    }

                    // A repeated group is drawn as a whole where its first parameter is listed.
                    if (!shownGroups.Add(groupKey))
                        continue;

                    int count = group.Count(node);
                    List<ParameterDescriptor> members = descriptor.Parameters.Where(p => p.Group == groupKey && p.Active(node)).ToList();
                    <div class="repeat-group">
                        @for (int i = 0; i < count; i++)
                        {
                            int index = i;
                            <fieldset class="repeat-item" @key="(node.Id, groupKey, index)">
                                <legend>
                                    <span>@group.ItemLabel @(index + 1)</span>
                                    @if (count > group.MinCount)
                                    {
                                        <button type="button" class="ghost danger small" title="Remove @group.ItemLabel.ToLowerInvariant() @(index + 1)"
                                                @onclick="() => State.RemoveGroupItem(node.Id, groupKey, index)">Remove</button>
                                    }
                                </legend>
                                @foreach (ParameterDescriptor member in members.Where(m => m.Active(node, index)))
                                {
                                    string key = RepeatGroupDescriptor.ItemKey(member.Key, index);
                                    <ParameterField State="State" Node="node" Instance="new ParameterInstance(member, key, group, index)"
                                                    Error="@ErrorFor(issues, key, node)"/>
                                }
                            </fieldset>
                        }
                        @if (count < group.MaxCount)
                        {
                            <button type="button" class="ghost add-item" title="Adds a copy of the last @group.ItemLabel.ToLowerInvariant()"
                                    @onclick="() => State.AddGroupItem(node.Id, groupKey)">+ Add @group.ItemLabel.ToLowerInvariant()</button>
                        }
                        @if (group.Help is not null)
                        {
                            <div class="field-help">@group.Help</div>
                        }
                    </div>
                }
            </section>
        }

        <section class="inspector-section">
            <h3>Fluid</h3>
            @for (int stream = 0; stream < descriptor.Streams.Count; stream++)
            {
                int s = stream;
                FluidSelection fluid = State.FluidOf(node.Id, s);
                <FluidPicker Label="@(descriptor.Streams.Count > 1 ? descriptor.Streams[s] : "Fluid")" Value="fluid"
                             ValueChanged="f => State.SetCircuitFluid(new StreamRef(node.Id, s), f)"/>
            }
            <div class="field-help">Applies to every component connected to this @(descriptor.Streams.Count > 1 ? "stream" : "component").</div>
        </section>

        @if (EnergyBalance.DescribeAuto(State.Document, State.Catalog, node) is var auto && (auto is not null || node.EnergyRole != EnergyRole.Auto))
        {
            <section class="inspector-section">
                <h3>Energy balance</h3>
                <div class="field">
                    <label for="energy-role">Counts as</label>
                    <select id="energy-role" value="@node.EnergyRole"
                            @onchange="e => State.SetEnergyRole(node.Id, Enum.Parse<EnergyRole>(e.Value?.ToString() ?? nameof(EnergyRole.Auto)))">
                        <option value="@EnergyRole.Auto">Automatic</option>
                        <option value="@EnergyRole.HeatInput">Heat input</option>
                        <option value="@EnergyRole.HeatOutput">Heat output</option>
                        <option value="@EnergyRole.PowerInput">Power input</option>
                        <option value="@EnergyRole.Ignore">Not counted</option>
                    </select>
                    <div class="field-help">
                        @(node.EnergyRole == EnergyRole.Auto
                            ? auto
                            : node.EnergyRole == EnergyRole.Ignore
                                ? "Left out of the heat and power totals."
                                : "Counts the enthalpy change of stream 1 (inlet to outlet).")
                    </div>
                </div>
            </section>
        }

        <ResultSection State="State" Node="node" Descriptor="descriptor"/>

        <GuessEditor State="State" Node="node" Descriptor="descriptor"/>
    }
    else if (State.SelectedNodeIds.Count > 1)
    {
        <div class="panel-header"><h2>@State.SelectedNodeIds.Count components selected</h2></div>
        <div class="button-row">
            <button type="button" class="ghost" @onclick="() => State.RotateSelection(90)">Rotate</button>
            <button type="button" class="ghost" @onclick="State.FlipSelection">Flip</button>
            <button type="button" class="ghost danger" @onclick="State.RemoveSelection">Delete</button>
        </div>
    }
    else if (SelectedConnection is { } connection)
    {
        <div class="panel-header"><h2>@(connection.Kind == ConnectionKind.Fluid ? "Fluid connection" : "Signal connection")</h2></div>
        <dl class="facts">
            <dt>From</dt><dd>@Describe(connection.From)</dd>
            <dt>To</dt><dd>@Describe(connection.To)</dd>
        </dl>
        @if (connection.Kind == ConnectionKind.Fluid && State.Result?.Port(connection.From.NodeId, connection.From.PortKey) is { } value)
        {
            <dl class="facts @(State.IsResultStale ? "stale" : "")">
                <dt>Mass flow</dt><dd><MassFlowText Value="FlowDirection.Of(State.Document, State.Catalog, connection.From, value)"/> kg/s</dd>
                <dt>Pressure</dt><dd>@Format.Pressure(value.Pressure) bar</dd>
                <dt>Temperature</dt><dd>@Format.Temperature(value.Temperature) °C</dd>
                <dt>Enthalpy</dt><dd>@Format.Enthalpy(value.Enthalpy) kJ/kg</dd>
            </dl>
        }
        <div class="button-row">
            @if (connection.Points is not null)
            {
                <button type="button" class="ghost" title="Go back to the automatic route"
                        @onclick="() => State.SetConnectionPoints(connection.Id, null)">Reset route</button>
            }
            <button type="button" class="ghost danger" @onclick="State.RemoveSelection">Delete connection</button>
        </div>
        <div class="field-help">Drag a segment or a corner of the line to change its route.</div>
    }
    else
    {
        <div class="panel-header"><h2>System</h2></div>
        <div class="field">
            <label for="system-name">Name</label>
            <input id="system-name" value="@State.Document.Name" @onchange="e => State.SetDocumentName(e.Value?.ToString() ?? State.Document.Name)"/>
        </div>
        <section class="inspector-section">
            <h3>Default fluid for new components</h3>
            <FluidPicker Label="Fluid" Value="State.Document.DefaultFluid"
                         ValueChanged="f => State.Edit(d => d.DefaultFluid = f)"/>
        </section>
        <section class="inspector-section help">
            <h3>How to</h3>
            <ul>
                <li>Drag components from the library onto the canvas.</li>
                <li>Drag from one port to another to connect them, or click both ports.</li>
                <li>Drag a line or one of its corners to reroute it.</li>
                <li>Connect a valve's top port to any fluid port to control on its temperature, superheat or mass flow.</li>
                <li>Pan with the right or middle mouse button, zoom with the wheel.</li>
                <li><kbd>R</kbd> rotate, <kbd>F</kbd> flip, <kbd>Del</kbd> delete, <kbd>Ctrl</kbd>+<kbd>Z</kbd> undo.</li>
            </ul>
        </section>
    }
</aside>

@code {
    [Parameter, EditorRequired] public EditorState State { get; set; } = null!;

    private ConnectionModel? SelectedConnection =>
        State.Document.Connections.FirstOrDefault(c => c.Id == State.SelectedConnectionId);

    private string Describe(PortRef port)
    {
        NodeModel? node = State.Document.FindNode(port.NodeId);
        string? label = node is null ? null : State.Catalog.Find(node.TypeId)?.FindPort(port.PortKey)?.Label;
        return node is null ? "?" : $"{node.Name} · {label ?? port.PortKey}";
    }

    private static string? ErrorFor(IReadOnlyList<ValidationIssue> issues, string key, NodeModel node) =>
        StripName(issues.FirstOrDefault(i => i.ParameterKey == key)?.Message, node);

    /// <summary>Field messages sit under the field, so the "Name: " prefix is redundant there.</summary>
    private static string? StripName(string? message, NodeModel node) =>
        message is not null && message.StartsWith(node.Name + ": ", StringComparison.Ordinal)
            ? message[(node.Name.Length + 2)..]
            : message;
}
