@* Editor for one stored parameter value of a node: a plain parameter or one item of a repeated group. *@
@{
    ParameterDescriptor parameter = Instance.Parameter;
    string key = Instance.Key;
}
@if (parameter.Kind == ParameterKind.Choice)
{
    string current = Node.Choices.GetValueOrDefault(key) ?? parameter.DefaultChoice ?? "";
    <div class="field">
        <label>@parameter.Label</label>
        <select value="@current" @onchange="e => State.SetChoice(Node.Id, key, e.Value?.ToString() ?? current)">
            @foreach (ChoiceOption option in parameter.OptionsShown(Node, key, State.Document, State.Catalog))
            {
                <option value="@option.Value">@option.Label</option>
            }
        </select>
        @if (Error is not null)
        {
            <div class="field-message @(IsWarning ? "warning" : "")">@Error</div>
        }
        @if (parameter.Info?.Invoke(Node, key) is { } info)
        {
            <div class="field-info">@info</div>
        }
        @if (parameter.Action is { } action && action.IsAvailable(Node, key))
        {
            <button type="button" class="field-action" @onclick="() => State.RunParameterAction(Node.Id, key)">@action.Label</button>
        }
        @if (parameter.Help is not null)
        {
            <div class="field-help">@parameter.Help</div>
        }
    </div>
}
else if (parameter.Kind == ParameterKind.Coefficients)
{
    <CoefficientsField @key="(Node.Id, key)" Label="@parameter.Label" Length="parameter.Length"
                       Labels="parameter.CoefficientLabels" Optional="parameter.Optional" Help="@parameter.Help"
                       Error="@Error"
                       Value="Node.Arrays.TryGetValue(key, out double[]? values) ? values : parameter.DefaultCoefficients"
                       ValueChanged="v => State.SetCoefficients(Node.Id, key, v)"/>
}
else
{
    <NumberField @key="(Node.Id, key)" Label="@parameter.Label" Unit="@parameter.Unit"
                 Optional="parameter.Optional" Help="@parameter.Help" Error="@Error"
                 Value="Node.Numbers.GetValueOrDefault(key, parameter.DefaultNumber)"
                 ValueChanged="v => State.SetNumber(Node.Id, key, v)">
        <LabelAction>
            @if (InStudy)
            {
                <span class="study-flag" title="Varied in the parametric study">in study</span>
            }
            else
            {
                <button type="button" class="study-add" title="Vary this parameter in a parametric study"
                        aria-label="Add @Instance.FullLabel to the parametric study"
                        @onclick="() => State.AddStudyVariable(Node.Id, key)">⊕</button>
            }
        </LabelAction>
    </NumberField>
}

@code {
    [Parameter, EditorRequired] public EditorState State { get; set; } = null!;
    [Parameter, EditorRequired] public NodeModel Node { get; set; } = null!;
    [Parameter, EditorRequired] public ParameterInstance Instance { get; set; } = null!;

    /// <summary>Validation message for this value, without the component name in front.</summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>True when <see cref="Error"/> is only a warning (shown for choices, which cannot be invalid).</summary>
    [Parameter] public bool IsWarning { get; set; }

    private bool InStudy =>
        State.Document.Study?.Variables.Any(v => v.NodeId == Node.Id && v.ParameterKey == Instance.Key) == true;
}
